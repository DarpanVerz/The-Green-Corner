{% assign products = collections[section.settings.collection].products %}
{% assign product_count = products.size %}

<section class="custom-collection-section shopify-section spaced-section">
  <div class="container-fluid">
    <div class="section-header">
      
      <div class="left-section-header">
        <div class="heading">
          {% if section.settings.subtitle != blank %}
            <p class="subtitle">{{ section.settings.subtitle }}</p>
          {% endif %}
          {% if section.settings.title != blank %}
            <h2>{{ section.settings.title }}</h2>
          {% endif %}
        </div>
      </div>

      <div class="right-section-header">
        <div class="description">
          {% if section.settings.description != blank %}
            <p class="desc">{{ section.settings.description }}</p>
          {% endif %}
        </div>

        <div class="button">
          {% if section.settings.button_text != blank %}
            <a href="{{ section.settings.button_link }}" class="browse-btn custom-btn">
              {{ section.settings.button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- Collection Grid -->
    <div
      class="collection-grid"
      style="--collection-columns: {{ section.settings.columns_desktop }};"
    >
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}

        {% if collection != blank %}
          <div class="grid-item" {{ block.shopify_attributes }}>
            <div class="card">
              <a href="{{ collection.url }}">
                {%- if block.settings.custom_collection_image != blank -%}
                  {%- assign card_image = block.settings.custom_collection_image -%}
                {%- elsif collection.image != blank -%}
                  {%- assign card_image = collection.image -%}
                {%- elsif collection.products.first.featured_image != blank -%}
                  {%- assign card_image = collection.products.first.featured_image -%}
                {%- else -%}
                  {%- assign card_image = blank -%}
                {%- endif -%}

                {% if card_image != blank %}
                  <img
                    src="{{ card_image | image_url: width: 600 }}"
                    srcset="
                      {{ card_image | image_url: width: 400 }} 400w,
                      {{ card_image | image_url: width: 600 }} 600w,
                      {{ card_image | image_url: width: 900 }} 900w
                    "
                    sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw"
                    width="{{ card_image.width }}"
                    height="{{ card_image.height }}"
                    alt="{{ collection.title | escape }}"
                    loading="lazy"
                  >
                {% endif %}

                <div class="card-content">
                  <h3>{{ collection.title }}</h3>
                  <span class="view-btn">{{ section.settings.card_button_text | default: 'View All' }}</span>
                </div>
              </a>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Slider",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Short Description"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "card_button_text",
      "label": "Card Button Text",
      "default": "View All"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Browse All Categories"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_collection_image",
          "label": "Custom Collection Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Slider",
      "blocks": [
        { "type": "collection_block" },
        { "type": "collection_block" },
        { "type": "collection_block" },
        { "type": "collection_block" }
      ]
    }
  ]
}
{% endschema %}