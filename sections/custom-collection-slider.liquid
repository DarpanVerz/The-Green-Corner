{%- comment -%}
  Hero Slider (Swiper)
  - Autoplay actually enabled (was: autoplay.enabled === false)
  - Pagination bullets clickable (was: clickable defaulting to false)
  - Prev/next arrows added
  - All selectors scoped to section.id so multiple instances don't fight
  - Re-inits on shopify:section:load, destroys on unload (theme editor)
  - Honours prefers-reduced-motion
{%- endcomment -%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"></noscript>

{%- assign uid = section.id -%}

{% style %}
  .hero-{{ uid }} {
    position: relative;
    overflow: hidden;
  }
  .hero-{{ uid }} .hero__swiper {
    width: 100%;
    height: {{ section.settings.height_desktop }}px;
    max-height: 100vh;
  }
  .hero-{{ uid }} .hero__slide {
    position: relative;
    display: flex;
    align-items: {{ section.settings.vertical_align }};
    overflow: hidden;
  }
  .hero-{{ uid }} .hero__media,
  .hero-{{ uid }} .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-{{ uid }} .hero__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0;
  }
  .hero-{{ uid }} .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 48px 24px;
  }
  .hero-{{ uid }} .hero__content {
    max-width: 560px;
    color: {{ section.settings.text_color }};
  }
  .hero-{{ uid }} .hero__content--center {
    margin-inline: auto;
    text-align: center;
  }
  .hero-{{ uid }} .hero__content--right {
    margin-inline-start: auto;
    text-align: right;
  }
  .hero-{{ uid }} .hero__subheading {
    margin: 0 0 12px;
    font-size: 13px;
    letter-spacing: .14em;
    text-transform: uppercase;
    opacity: .85;
  }
  .hero-{{ uid }} .hero__heading {
    margin: 0 0 16px;
    font-size: clamp(28px, 4.4vw, 56px);
    line-height: 1.08;
  }
  .hero-{{ uid }} .hero__text {
    margin: 0 0 28px;
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.6;
    opacity: .9;
  }
  .hero-{{ uid }} .hero__btn {
    display: inline-block;
    padding: 14px 30px;
    border-radius: {{ section.settings.button_radius }}px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text_color }};
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: transform .2s ease, opacity .2s ease;
  }
  .hero-{{ uid }} .hero__btn:hover { opacity: .9; transform: translateY(-1px); }
  .hero-{{ uid }} .hero__btn:focus-visible,
  .hero-{{ uid }} .swiper-button-prev:focus-visible,
  .hero-{{ uid }} .swiper-button-next:focus-visible,
  .hero-{{ uid }} .swiper-pagination-bullet:focus-visible {
    outline: 2px solid {{ section.settings.text_color }};
    outline-offset: 3px;
  }

  /* Pagination — bottom right, and actually clickable */
  .hero-{{ uid }} .hero__pagination {
    position: absolute;
    z-index: 5;
    bottom: 28px;
    right: 32px;
    left: auto;
    width: auto;
    display: flex;
    gap: 10px;
  }
  .hero-{{ uid }} .hero__pagination .swiper-pagination-bullet {
    width: 10px;
    height: 10px;
    margin: 0;
    background: {{ section.settings.text_color }};
    opacity: .4;
    cursor: pointer;
    transition: opacity .2s ease, width .2s ease;
  }
  .hero-{{ uid }} .hero__pagination .swiper-pagination-bullet-active {
    opacity: 1;
    width: 26px;
    border-radius: 5px;
  }

  /* Arrows */
  .hero-{{ uid }} .swiper-button-prev,
  .hero-{{ uid }} .swiper-button-next {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0,0,0,.35);
    color: {{ section.settings.text_color }};
    backdrop-filter: blur(4px);
    transition: background .2s ease;
  }
  .hero-{{ uid }} .swiper-button-prev:hover,
  .hero-{{ uid }} .swiper-button-next:hover { background: rgba(0,0,0,.6); }
  .hero-{{ uid }} .swiper-button-prev::after,
  .hero-{{ uid }} .swiper-button-next::after { font-size: 16px; font-weight: 700; }
  .hero-{{ uid }} .swiper-button-prev { left: 24px; }
  .hero-{{ uid }} .swiper-button-next { right: 24px; }

  {% unless section.settings.show_arrows %}
    .hero-{{ uid }} .swiper-button-prev,
    .hero-{{ uid }} .swiper-button-next { display: none; }
  {% endunless %}

  @media (max-width: 749px) {
    .hero-{{ uid }} .hero__swiper { height: {{ section.settings.height_mobile }}px; }
    .hero-{{ uid }} .hero__content { max-width: 100%; text-align: {{ section.settings.mobile_text_align }}; }
    .hero-{{ uid }} .hero__content--center,
    .hero-{{ uid }} .hero__content--right { margin-inline: 0; }
    .hero-{{ uid }} .swiper-button-prev,
    .hero-{{ uid }} .swiper-button-next { display: none; }
    .hero-{{ uid }} .hero__pagination { bottom: 18px; right: 20px; }
    .hero-{{ uid }} .hero__inner { padding: 32px 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-{{ uid }} .hero__btn { transition: none; }
  }
{% endstyle %}

<section
  class="hero-slider hero-{{ uid }}"
  data-section-id="{{ uid }}"
  data-section-type="hero-slider"
>
  <div
    class="swiper hero__swiper"
    id="HeroSwiper-{{ uid }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-autoplay-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
    data-loop="{{ section.settings.loop }}"
    data-speed="{{ section.settings.transition_speed }}"
    data-effect="{{ section.settings.transition_effect }}"
  >
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        <div class="swiper-slide hero__slide" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="hero__media">
              <img
                src="{{ block.settings.image | image_url: width: 2000 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 800 }} 800w,
                  {{ block.settings.image | image_url: width: 1200 }} 1200w,
                  {{ block.settings.image | image_url: width: 1600 }} 1600w,
                  {{ block.settings.image | image_url: width: 2000 }} 2000w
                "
                sizes="100vw"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
              >
            </div>
          {%- endif -%}

          <div class="hero__overlay" style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></div>

          <div class="hero__inner">
            <div class="hero__content hero__content--{{ block.settings.text_position }}">
              {%- if block.settings.subheading != blank -%}
                <p class="hero__subheading">{{ block.settings.subheading | escape }}</p>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h2 class="hero__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="hero__text">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- if block.settings.button_label != blank -%}
                <a
                  class="hero__btn"
                  href="{{ block.settings.button_link | default: '#' }}"
                  {% unless forloop.first %}tabindex="-1"{% endunless %}
                >
                  {{ block.settings.button_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_pagination and section.blocks.size > 1 -%}
      <div class="swiper-pagination hero__pagination" id="HeroPagination-{{ uid }}"></div>
    {%- endif -%}

    {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
      <div class="swiper-button-prev" id="HeroPrev-{{ uid }}" aria-label="Previous slide"></div>
      <div class="swiper-button-next" id="HeroNext-{{ uid }}" aria-label="Next slide"></div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    if (window.__heroSliderBoot) return;
    window.__heroSliderBoot = true;

    var SWIPER_JS = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';

    function loadSwiper() {
      if (window.Swiper) return Promise.resolve();
      if (window.__swiperPromise) return window.__swiperPromise;
      window.__swiperPromise = new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = SWIPER_JS;
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
      return window.__swiperPromise;
    }

    window.HeroSlider = {
      init: function (root) {
        if (!root) return;
        var el = root.querySelector('.hero__swiper');
        if (!el) return;

        // Guard against double-init on the same node
        if (el.swiper) el.swiper.destroy(true, true);

        var id = root.getAttribute('data-section-id');
        var slides = el.querySelectorAll('.swiper-slide').length;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var wantsAutoplay = el.dataset.autoplay === 'true' && slides > 1 && !reduce;

        loadSwiper().then(function () {
          var options = {
            loop: el.dataset.loop === 'true' && slides > 1,
            speed: reduce ? 0 : parseInt(el.dataset.speed, 10) || 700,
            effect: el.dataset.effect || 'slide',
            slidesPerView: 1,
            watchSlidesProgress: true,
            keyboard: { enabled: true, onlyInViewport: true },
            a11y: {
              enabled: true,
              prevSlideMessage: 'Previous slide',
              nextSlideMessage: 'Next slide',
              paginationBulletMessage: '{% raw %}Go to slide {{index}}{% endraw %}'
            },
            pagination: {
              el: '#HeroPagination-' + id,
              clickable: true,          // <-- the dots fix
              bulletElement: 'button'
            },
            navigation: {
              prevEl: '#HeroPrev-' + id,
              nextEl: '#HeroNext-' + id
            },
            on: {
              // keep hidden slides out of the tab order
              slideChangeTransitionEnd: function (sw) {
                sw.slides.forEach(function (slide) {
                  var focusables = slide.querySelectorAll('a, button');
                  var active = slide.classList.contains('swiper-slide-active');
                  focusables.forEach(function (node) {
                    node.setAttribute('tabindex', active ? '0' : '-1');
                  });
                });
              }
            }
          };

          if (el.dataset.effect === 'fade') {
            options.fadeEffect = { crossFade: true };
          }

          if (wantsAutoplay) {
            options.autoplay = {          // <-- the autoplay fix
              delay: parseInt(el.dataset.autoplayDelay, 10) || 6000,
              disableOnInteraction: false,
              pauseOnMouseEnter: true
            };
          }

          var instance = new Swiper(el, options);

          // Pause while the tab is hidden so slides don't pile up
          if (wantsAutoplay) {
            document.addEventListener('visibilitychange', function () {
              if (!el.swiper) return;
              document.hidden ? el.swiper.autoplay.stop() : el.swiper.autoplay.start();
            });
          }

          return instance;
        });
      },

      destroy: function (root) {
        var el = root && root.querySelector('.hero__swiper');
        if (el && el.swiper) el.swiper.destroy(true, true);
      }
    };

    function initAll(scope) {
      (scope || document).querySelectorAll('[data-section-type="hero-slider"]').forEach(function (root) {
        window.HeroSlider.init(root);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { initAll(); });
    } else {
      initAll();
    }

    // Theme editor: sections are re-rendered on every change
    document.addEventListener('shopify:section:load', function (e) {
      initAll(e.target);
    });
    document.addEventListener('shopify:section:unload', function (e) {
      var root = e.target.querySelector('[data-section-type="hero-slider"]');
      if (root) window.HeroSlider.destroy(root);
    });
    document.addEventListener('shopify:block:select', function (e) {
      var root = e.target.closest('[data-section-type="hero-slider"]');
      if (!root) return;
      var el = root.querySelector('.hero__swiper');
      if (!el || !el.swiper) return;
      if (el.swiper.autoplay && el.swiper.autoplay.running) el.swiper.autoplay.stop();
      var index = Array.prototype.indexOf.call(e.target.parentNode.children, e.target);
      el.swiper.slideToLoop ? el.swiper.slideToLoop(index) : el.swiper.slideTo(index);
    });
    document.addEventListener('shopify:block:deselect', function (e) {
      var root = e.target.closest('[data-section-type="hero-slider"]');
      var el = root && root.querySelector('.hero__swiper');
      if (el && el.swiper && el.swiper.autoplay) el.swiper.autoplay.start();
    });
  })();
</script>

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "hero-slider-section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Slideshow behaviour" },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotate slides automatically",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Seconds between slides",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop back to the first slide",
      "default": true
    },
    {
      "type": "select",
      "id": "transition_effect",
      "label": "Transition",
      "options": [
        { "value": "slide", "label": "Slide" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": "slide"
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Transition speed",
      "min": 200,
      "max": 1500,
      "step": 100,
      "unit": "ms",
      "default": 700
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Height on desktop",
      "min": 320,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 620
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height on mobile",
      "min": 260,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 460
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Content width",
      "min": 960,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_text_align",
      "label": "Text alignment on mobile",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },

    { "type": "header", "content": "Colors" },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image",
          "info": "Recommended 1600 x 550 or wider."
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Image darkening",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 35
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Give each slide its own heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
